{
  "name": "mcsimusic-be",
  "version": "0.0.0",
  "description": "McSiMusic back end",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch --inspect --require ts-node/register src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "run": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McSiMusic/McSiMusic.git"
  },
  "keywords": [
    "music"
  ],
  "author": "McSiMusic",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/McSiMusic/McSiMusic/issues"
  },
  "homepage": "https://github.com/McSiMusic/McSiMusic#readme",
  "dependencies": {
    "@audio/decode": "^4.2.0",
    "canvas": "^3.2.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "googleapis": "^189.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "music-metadata": "^12.3.4",
    "music-tempo": "^1.0.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
